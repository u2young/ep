<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>xyz.herz.ep</groupId>
        <artifactId>ep-business-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ep-boot</artifactId>
    <packaging>jar</packaging>
    <name>ep-boot</name>
    <description>
        应用层(打包启动入口)。
        - 职责:Spring Boot 启动类、application.yml 配置、按需要装配哪些业务模块(dependency 引入哪些 module);
        - 不写任何业务代码,只负责「装配 + 运行」;
        - 后续 erupt-cloud 拆分时,可按业务域复制多份,各自引入不同 module 组合。
    </description>

    <dependencies>
        <!-- 业务模块按需引入 -->
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-crm</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-erp</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-fin</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-mfg</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-proj</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-sup</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-ast</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-mall</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-wms</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-mp</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-iot</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-landing</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-hr</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-pay</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-qal</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-pur</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-stk</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.herz.ep</groupId>
            <artifactId>ep-module-sal</artifactId>
        </dependency>

        <!-- ============ erupt 全家桶:运行时只在 boot 层聚合 ============ -->
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-web</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-ai-claw</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-terminal</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-tpl</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-job</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-generator</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-monitor</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-magic-api</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-excel</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-security</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-designer</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-notice</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-print</artifactId>
        </dependency>
        <dependency>
            <groupId>xyz.erupt</groupId>
            <artifactId>erupt-report</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- ============ 编译期工具(与各业务模块一致,父 pom 已 managed version+provided) ============ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ============ 测试 ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ep-business</finalName>
        <plugins>
            <!-- 只有 boot 层打可执行 jar,业务模块不打 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
