{
  "type": "page",
  "title": "",
  "body": [
    {
      "type": "grid",
      "className": "bg-gradient-to-br from-purple-900 to-indigo-800 text-white p-y-4xl p-x-xl",
      "columns": [
        {
          "sm": false,
          "md": true,
          "body": [
            { "type": "tpl", "tpl": "<span class=\"badge bg-white text-purple-700 m-b-sm\">线上研讨会 · 免费参与</span>", "className": "m-b-sm" },
            { "type": "tpl", "tpl": "<h1 class=\"m-y-sm text-4xl\">2024 AI 驱动营销<br>增长实战峰会</h1>", "className": "text-5xl fw-bold m-y-sm" },
            { "type": "tpl", "tpl": "<p class=\"opacity-80 text-xl m-b-lg\">AI 如何重塑营销获客链路？3 位实战专家，3 小时干货分享</p>", "className": "opacity-80" },
            { "type": "group", "className": "m-y-lg", "body": [
              { "type": "tpl", "tpl": "<div class=\"d-flex align-items-center gap-3\"><span class=\"text-2xl\">📅</span><div><strong>日期</strong><br><span class=\"opacity-75\">2024.10.25（周五）14:00-17:00</span></div></div>" },
              { "type": "tpl", "tpl": "<div class=\"d-flex align-items-center gap-3 mt-3\"><span class=\"text-2xl\">📍</span><div><strong>形式</strong><br><span class=\"opacity-75\">线上 Zoom 直播 + 回放</span></div></div>" },
              { "type": "tpl", "tpl": "<div class=\"d-flex align-items-center gap-3 mt-3\"><span class=\"text-2xl\">🎁</span><div><strong>福利</strong><br><span class=\"opacity-75\">参会即送 AI 营销工具包</span></div></div>" }
            ]}
          ]
        },
        {
          "sm": true,
          "md": true,
          "body": [
            {
              "type": "form",
              "title": "立即报名",
              "className": "bg-white text-dark rounded-xl p-xl shadow-lg",
              "api": "/api/landing/lead",
              "body": [
                { "type": "input-text", "name": "name", "label": "姓名", "required": true, "placeholder": "您的姓名" },
                { "type": "input-text", "name": "company", "label": "公司", "required": true, "placeholder": "所在公司" },
                { "type": "input-mobile", "name": "phone", "label": "手机号", "required": true, "placeholder": "用于接收参会链接" },
                { "type": "input-email", "name": "email", "label": "邮箱", "required": true, "placeholder": "工作邮箱" },
                { "type": "input-select", "name": "role", "label": "职位", "required": true, "options": [
                  { "label": "市场/运营", "value": "marketing" },
                  { "label": "销售", "value": "sales" },
                  { "label": "产品经理", "value": "pm" },
                  { "label": "技术/研发", "value": "tech" },
                  { "label": "企业负责人", "value": "ceo" },
                  { "label": "其他", "value": "other" }
                ]},
                { "type": "input-radio", "name": "interest", "label": "最关注的话题", "options": [
                  { "label": "AI 内容生成", "value": "content" },
                  { "label": "精准获客", "value": "acquisition" },
                  { "label": "数据分析", "value": "analytics" },
                  { "label": "自动化营销", "value": "automation" }
                ]}
              ]
            }
          ]
        }
      ]
    },
    {
