            { "type": "tpl", "tpl": "<div class=\"avatar-circle m-auto m-b-sm\" style=\"width:80px;height:80px;border-radius:50%;background:#8b5cf6;display:flex;align-items:center;justify-content:center;color:white;font-size:28px;\">李</div>", "className": "text-4xl" },
            { "type": "tpl", "tpl": "<h5 class=\"m-t-none\">李晓雪</h5>", "className": "text-lg fw-bold" },
            { "type": "tpl", "tpl": "<p class=\"text-muted m-b-none\">增长黑客社区创始人 · 10 年营销经验<br><span class=\"fs-sm\">主题：AI 驱动的精准获客链路</span></p>", "className": "text-muted fs-sm" }
          ]
        },
        {
          "type": "card",
          "className": "text-center p-xl",
          "body": [
            { "type": "tpl", "tpl": "<div class=\"avatar-circle m-auto m-b-sm\" style=\"width:80px;height:80px;border-radius:50%;background:#a78bfa;display:flex;align-items:center;justify-content:center;color:white;font-size:28px;\">陈</div>", "className": "text-4xl" },
            { "type": "tpl", "tpl": "<h5 class=\"m-t-none\">陈志远</h5>", "className": "text-lg fw-bold" },
            { "type": "tpl", "tpl": "<p class=\"text-muted m-b-none\">某 SaaS 企业 CMO · 数据驱动营销专家<br><span class=\"fs-sm\">主题：用 AI 重构营销数据分析</span></p>", "className": "text-muted fs-sm" }
          ]
        }
      ]
