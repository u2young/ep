            {
              "body": [
                { "type": "tpl", "tpl": "<div class=\"bg-white rounded-xl p-xl text-center\"><h5 class=\"m-t-none\">已报名 <span class=\"text-primary display-4\">326</span> 人</h5><p class=\"text-muted m-b-sm\">还剩 <strong class=\"text-danger\">4</strong> 个名额</p><small class=\"text-muted\">上次峰会满员提前关闭报名</small></div>", "className": "text-center" }
              ]
            }
          ]
        }
      ]
